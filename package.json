{
  "name": "spacecom-encounter-analyzer",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "vp check && vp run -r check-types",
    "test": "vp test run",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "dev:cli": "vp run --filter @spacecom-encounter-analyzer/engine build && vp run --filter @spacecom-encounter-analyzer/cli dev",
    "build:cli": "vp run --filter @spacecom-encounter-analyzer/engine build && vp run --filter @spacecom-encounter-analyzer/cli build",
    "start": "pnpm build:cli && pnpm --filter @spacecom-encounter-analyzer/cli start",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@spacecom-encounter-analyzer/config": "workspace:*",
    "@types/node": "catalog:",
    "husky": "latest",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "rolldown": "1.2.15",
    "typescript": "catalog:",
    "ultracite": "8.0.0",
    "vite-plus": "1.4.0",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.14.0"
}
