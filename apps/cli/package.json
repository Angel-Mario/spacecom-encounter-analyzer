{
  "name": "@spacecom-encounter-analyzer/cli",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "dev": "varlock run -- tsx watch src/index.ts",
    "start": "varlock run -- node dist/index.mjs"
  },
  "dependencies": {
    "@spacecom-encounter-analyzer/engine": "workspace:*",
    "varlock": "catalog:"
  },
  "devDependencies": {
    "@spacecom-encounter-analyzer/config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "catalog:"
  }
}
