{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spacecom Encounter Analyzer",
  "version": "0.1.0",
  "identifier": "com.spacecom-encounter-app.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && pnpm prepare:bundle",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Spacecom Encounter Analyzer",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 720,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
