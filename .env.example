# Spacecom Encounter Analyzer - Example Environment Configuration
# Copy this file to .env to customize local settings.
# Validated against .env.schema by varlock.

# Relative path to input directory for `process-all` and `benchmark`
SPACECOM_INPUT_DIR=datasets/inputs

# Relative path to output directory for `process` and `process-all`
SPACECOM_OUTPUT_DIR=datasets/outputs

# Behavior when timestamps are not in ascending order:
# prompt (interactive confirmation), external (disk-backed sorting), cancel (abort)
SPACECOM_UNSORTED_STRATEGY=prompt

# Parallel engine chunk size in bytes handed to worker threads (default: 8388608 = 8MB)
SPACECOM_CHUNK_BYTES=8388608

# Maximum worker threads spawned for parallel processing.
# When empty or omitted, defaults to os.availableParallelism() - 1
SPACECOM_MAX_WORKERS=
