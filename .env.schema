# Spacecom Encounter Analyzer environment configuration.
#
# Declared with varlock (https://varlock.dev). This schema is the single
# source of truth: everything deployable and tunable is declared here, the
# values below are the built-in defaults, and wrapped commands validate on
# startup (`varlock run` wraps the CLI scripts).
# ---

# Nothing here is a secret and everything has a fallback, so items are
# optional and public unless decorated otherwise below.
# @defaultRequired=false
# @defaultSensitive=false
# ---

# All variables are optional and non-sensitive. Local overrides belong in a
# git-ignored `.env` file next to this schema, or can be exported in the
# shell. Unknown variables in `.env` are rejected by varlock.
# ---

# Relative paths, resolved against the workspace root.
# Input directory for `process-all` and `benchmark` when `--input` is not given.
SPACECOM_INPUT_DIR=datasets/inputs

# Output directory for `process` and `process-all` when `--output` is not given.
SPACECOM_OUTPUT_DIR=datasets/outputs

# Behavior when timestamps are not in ascending order:
# prompt (ask interactively), external (disk-backed sorting), cancel (stop).
# In non-interactive terminals use external or cancel.
# @type=enum(prompt, external, cancel)
SPACECOM_UNSORTED_STRATEGY=prompt

# ---

# Engine parallel-processing tunables. They apply to every dataset processed
# in parallel and are ignored when the caller passes explicit options.

# Target size, in bytes, of each line-aligned byte-range chunk handed to a
# worker thread. Files smaller than two chunks run entirely in-process.
# @type=number(isInt=true, min=1)
SPACECOM_CHUNK_BYTES=8388608

# Maximum number of worker threads spawned for one dataset. When unset, the
# engine uses os.availableParallelism() - 1.
# @type=number(isInt=true, min=1)
SPACECOM_MAX_WORKERS=
